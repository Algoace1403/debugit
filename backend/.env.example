# ── CI/CD Healing Agent — Backend Environment Variables ──

# OpenAI API key (bug classification + fix generation)
OPENAI_API_KEY=sk-...

# GitHub personal access token (repo read/write, actions read)
# Must have permissions: contents:write, actions:read on target repos
GITHUB_TOKEN=ghp_...

# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=...
FRONTEND_URL=http://localhost:5173

# Directory for run artifacts (cloned repos, state, results)
# Railway: mount a volume at /data and set DATA_DIR=/data/runs
DATA_DIR=/data/runs

# CORS allowed origins (comma-separated, no trailing slashes)
# Set to your Vercel frontend URL in production
# Example: https://ci-heal-agent.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max healing iterations before stopping (default: 5)
MAX_ITERATIONS=5
